<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Premium_Amount_positive</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISBLANK(Premium_Amount__c)), Premium_Amount__c > 0)</errorConditionFormula>
    <errorDisplayField>Premium_Amount__c</errorDisplayField>
    <errorMessage>Premium amount must be greater than zero.</errorMessage>
</ValidationRule>
